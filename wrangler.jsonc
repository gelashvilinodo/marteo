{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marteo",
  "main": "worker.mjs",
  "minify": true,
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/_csp-static/*"]
  },
  "triggers": {
    // Hourly cleanup of support chat messages older than 24 hours.
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://marteo.ge",
    "RESEND_FROM_EMAIL": "MARTEO <auth@marteo.ge>",
    "SENDSMS_BASE_URL": "https://sendsms.ge/api",
    "SENDSMS_SENDER": "MARTEO",
    "VAPID_PUBLIC_KEY": "BL7fR_hUGjBN_nDxSeDrfL3VeQxb6wEH6QB7h1xMpyqN1arixRg6WCTOslrXDC5EngvCpvOaKksKaja4Abx1rso",
    "VAPID_SUBJECT": "mailto:marteobusiness@gmail.com"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c0d77418803347aa9d2f9527c9b48e93"
    }
  ]
}